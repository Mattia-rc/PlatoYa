# Copiar a .env (que no se versiona) y ajustar los valores.
# Credenciales solo para el entorno local.
POSTGRES_DB=platoya
POSTGRES_USER=platoya
POSTGRES_PASSWORD=cambiar-esta-clave

# Puertos publicados en la máquina. Cambiarlos si alguno está ocupado.
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
